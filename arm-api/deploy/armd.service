# systemd unit for armd, the HTTP API service for the SO-101 arms.
# Install: run deploy/install.sh on the server and follow its instructions.
# Logs: journalctl -u armd -f

[Unit]
Description=armd - HTTP API for the SO-101 robot arms
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=intel
Group=dialout
SupplementaryGroups=dialout
WorkingDirectory=/home/intel/arm-api
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/intel/miniforge3/envs/armd/bin/python -m armd --config /home/intel/arm-api/config.yaml
Restart=always
RestartSec=2
# Give the service time to do on_shutdown (hold or limp) after SIGTERM, before SIGKILL.
TimeoutStopSec=10

# Light hardening. Do not use PrivateDevices: the service must open /dev/ttyACM*.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
