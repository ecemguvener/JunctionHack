[Unit]
Description=Station twin dashboard: Top camera sim/real, D415 point cloud (127.0.0.1:8096)

[Service]
WorkingDirectory=%h/brickcell-dashboard
ExecStart=%h/.local/bin/uv run --offline --no-project --python 3.12 --with numpy --with opencv-python-headless python %h/brickcell-dashboard/server.py --host 127.0.0.1 --port 8096
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
